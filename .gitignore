## Ignore Visual Studio temporary files, build results, and files generated by popular Visual Studio add-ons.
## Source: https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

.vs/
**/bin/
**/obj/

# User-specific files
*.user
*.userosscache
*.suo
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]in/
[Oo]bj/

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet packages
*.nupkg
*.snupkg
**/packages/*

# OS-generated files
.DS_Store
Thumbs.db

# Local environment and secrets
.env
.env.*
!.env.example

# Coverage reports
coverage/
*.coverage
*.coveragexml
